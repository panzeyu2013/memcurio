{
  "name": "memcurio",
  "version": "0.1.0",
  "description": "Harness-agnostic, language-agnostic memory and context management for AI coding agents (opencode)",
  "license": "MIT",
  "author": "memcurio contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panzeyu2013/memcurio.git"
  },
  "bugs": {
    "url": "https://github.com/panzeyu2013/memcurio/issues"
  },
  "homepage": "https://github.com/panzeyu2013/memcurio#readme",
  "keywords": [
    "memory",
    "context",
    "agent",
    "opencode",
    "mcp",
    "sqlite",
    "llm"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/opencode-memcurio-plugin.js",
  "types": "./dist/cli/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./server": "./dist/opencode-memcurio-plugin.js",
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    }
  },
  "bin": {
    "memcurio": "dist/cli/index.js"
  },
  "scripts": {
    "build": "bun run scripts/clean-dist.ts && tsc && bun run scripts/chmod-cli.ts && bun run build:dsh",
    "build:dsh": "tsc -p packages/dsh-plugin/tsconfig.json",
    "prepare": "node scripts/prepare.mjs",
    "test": "bun test",
    "lint": "biome lint src tests scripts packages/dsh-plugin/src packages/dsh-plugin/tests",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && bun run typecheck:dsh",
    "typecheck:dsh": "tsc --noEmit -p packages/dsh-plugin/tsconfig.json && tsc --noEmit -p packages/dsh-plugin/tsconfig.typecheck.json",
    "dev": "bun run src/cli/index.ts",
    "bundle:plugin": "bun run scripts/bundle-opencode-plugin.ts",
    "pack:check": "bun run build && bun run bundle:plugin && bun run scripts/pack-check.ts",
    "eval:lexical": "bun run scripts/eval-lexical.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@opencode-ai/plugin": "^1.18.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "zod": "4.4.3"
  }
}
