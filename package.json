{
  "name": "@memcurio/dsh-plugin",
  "version": "0.0.1",
  "description": "Memory and context management plugin for the DeepSeek Harness (DSH)",
  "license": "MIT",
  "author": "memcurio contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panzeyu2013/memcurio.git"
  },
  "bugs": {
    "url": "https://github.com/panzeyu2013/memcurio/issues"
  },
  "homepage": "https://github.com/panzeyu2013/memcurio#readme",
  "keywords": [
    "memory",
    "context",
    "agent",
    "dsh",
    "deepseek-harness",
    "cordis",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "bun@1.3.14",
  "files": [
    "dist",
    "lib",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/plugin/index.js",
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "bun run scripts/clean-dist.ts && tsc && bun run build:client",
    "prepare": "node scripts/prepare.mjs",
    "test": "bun test",
    "lint": "biome lint src tests scripts client",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pack:check": "bun run build && bun run scripts/pack-check.ts",
    "eval:lexical": "bun run scripts/eval-lexical.ts",
    "pack:tgz": "bun run build && mkdir -p .smoke && bun pm pack --destination .smoke --ignore-scripts",
    "release:notes": "node scripts/release-notes.mjs",
    "verify:workflows": "node scripts/verify-workflow-action-pins.mjs",
    "build:client": "bun scripts/build-client.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings-file": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.25.0",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
