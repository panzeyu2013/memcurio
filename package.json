{
  "name": "memcore",
  "version": "0.1.0",
  "description": "跨 Harness 记忆与上下文管理系统核心引擎（harness 无关、语言无关）",
  "license": "MIT",
  "author": "memcore contributors",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=23.4"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "memcore": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "bun run build && bun run bundle:plugin",
    "prepack": "bun run build && bun run bundle:plugin",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "dev": "bun run src/cli/index.ts",
    "bundle:plugin": "bun run scripts/bundle-opencode-plugin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  }
}
