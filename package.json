{
  "name": "@memcurio/dsh-plugin",
  "version": "0.0.1",
  "description": "Memory and context management plugin for the DeepSeek Harness (DSH)",
  "license": "MIT",
  "author": "memcurio contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panzeyu2013/memcurio.git"
  },
  "bugs": {
    "url": "https://github.com/panzeyu2013/memcurio/issues"
  },
  "homepage": "https://github.com/panzeyu2013/memcurio#readme",
  "keywords": [
    "memory",
    "context",
    "agent",
    "dsh",
    "deepseek-harness",
    "cordis",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/plugin/index.js",
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "bun run scripts/clean-dist.ts && tsc",
    "prepare": "node scripts/prepare.mjs",
    "test": "bun test",
    "lint": "biome lint src tests scripts client",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pack:check": "bun run build && bun run scripts/pack-check.ts",
    "eval:lexical": "bun run scripts/eval-lexical.ts",
    "pack:tgz": "bun run build && mkdir -p .smoke && bun pm pack --destination .smoke --ignore-scripts",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
